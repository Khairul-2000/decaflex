# --- LLM (OpenRouter, OpenAI-compatible) ---
ARGENTURA_CONVERSATION_AGENT_PROVIDER=openai-compatible
# The full /chat/completions URL also works; the app strips that suffix for LangChain.
ARGENTURA_AGENT_ENDPOINT=https://openrouter.ai/api/v1
ARGENTURA_AGENT_MODEL=x-ai/grok-4.3
ARGENTURA_AGENT_API_KEY=

# --- Generation ---
TEMPERATURE=0.9
MAX_TOKENS=400

# --- Chat history (short-term only; nothing is written to Postgres) ---
HISTORY_TURNS=20
SESSION_TTL_SECONDS=86400
# Leave empty for in-memory history (lost on restart). Example: redis://redis:6379/0
REDIS_URL=

# --- Limits ---
RATE_LIMIT_PER_MINUTE=12
DAILY_MESSAGE_CAP=300

# --- Telegram (leave token empty to disable) ---
TELEGRAM_BOT_TOKEN=
# Set a public HTTPS URL (e.g. https://your-domain/telegram/webhook) for webhook mode.
# Leave empty to use long polling (fine for local dev).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Web ---
CORS_ORIGINS=*
APP_URL=http://localhost:8000
